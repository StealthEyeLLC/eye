<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net10.0-windows\</OutputPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>eye-worker</AssemblyName>
    <RootNamespace>StealthEye.Worker</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Nerdbank.Streams" Version="2.13.16" />
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Eye\Contract\RpcTransport.cs" Link="Contract\RpcTransport.cs" />
    <Compile Include="..\Eye\Contract\WorkerRpc.cs" Link="Contract\WorkerRpc.cs" />
    <Compile Include="..\Eye\Runtime\NativeMethods.cs" Link="Runtime\NativeMethods.cs" />
    <Compile Include="..\Eye\Runtime\ProcessRunHooks.cs" Link="Runtime\ProcessRunHooks.cs" />
    <Compile Include="..\Eye\Runtime\ProcessRunner.cs" Link="Runtime\ProcessRunner.cs" />
    <Compile Include="..\Eye\Runtime\RunModels.cs" Link="Runtime\RunModels.cs" />
    <Compile Include="..\Eye\Runtime\ConPtySession.cs" Link="Runtime\ConPtySession.cs" />
  </ItemGroup>
</Project>
