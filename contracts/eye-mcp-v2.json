{
  "contract": "stealtheye.eye.mcp",
  "version": "2.0.0",
  "status": "canonical-target",
  "publication_state": "not-live-until-generated",
  "supersedes": "contracts/eye-mcp-v1.json",
  "summary": "Five effect-class capability tools plus one UI-only Eye Live tool over one stable host and one supervised versioned capability engine.",
  "tools": [
    {
      "name": "eye_inspect",
      "effect_class": "inspect",
      "description": "Read, search, observe, query, wait, subscribe, and diagnose StealthEye machine state.",
      "machine_effects": "read-only-or-observational",
      "operations": [
        {
          "id": "system.status",
          "args_required": false,
          "args_schema": { "type": "object", "additionalProperties": false },
          "result_schema": {
            "type": "object",
            "properties": {
              "product": { "const": "StealthEye" },
              "executable": { "const": "eye" },
              "version": { "type": "string" },
              "contract": { "const": "eye-mcp-v2" },
              "process_id": { "type": "integer" },
              "machine": { "type": "string" },
              "identity": { "type": "string" },
              "started_at": { "type": "string", "format": "date-time" }
            },
            "required": ["product", "executable", "version", "contract", "process_id", "machine", "identity", "started_at"],
            "additionalProperties": false
          }
        },
        {
          "id": "capabilities",
          "args_required": false,
          "args_schema": { "type": "object", "additionalProperties": false },
          "result_schema": {
            "type": "object",
            "properties": {
              "contract": { "const": "eye-mcp-v2" },
              "facades": {
                "type": "object",
                "properties": {
                  "eye_inspect": { "type": "array", "items": { "type": "string" } },
                  "eye_run": { "type": "array", "items": { "type": "string" } },
                  "eye_change": { "type": "array", "items": { "type": "string" } },
                  "eye_interact": { "type": "array", "items": { "type": "string" } },
                  "eye_external": { "type": "array", "items": { "type": "string" } },
                  "eye_live": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["eye_inspect", "eye_run", "eye_change", "eye_interact", "eye_external", "eye_live"],
                "additionalProperties": false
              }
            },
            "required": ["contract", "facades"],
            "additionalProperties": false
          }
        }
      ,
        {
          "id": "job.status",
          "args_required": true,
          "args_schema": {
            "type": "object",
            "properties": { "job_id": { "type": "string", "minLength": 1 } },
            "required": ["job_id"],
            "additionalProperties": false
          },
          "result_schema": {
            "type": "object",
            "properties": {
              "job_id": { "type": "string", "minLength": 1 },
              "incarnation": { "type": "integer", "minimum": 1 },
              "state": { "type": "string", "enum": ["starting", "running", "completed", "timed_out", "cancelled", "failed", "interrupted"] },
              "context": { "type": "string", "enum": ["system", "user", "wsl"] },
              "pid": { "type": "integer", "minimum": 0 },
              "effective_identity": { "type": "string" },
              "created_at": { "type": "string", "format": "date-time" },
              "started_at": { "type": "string", "format": "date-time" },
              "completed_at": { "type": "string", "format": "date-time" },
              "exit_code": { "type": "integer" },
              "timed_out": { "type": "boolean" },
              "failure_code": { "type": "string" },
              "failure_message": { "type": "string" }
            },
            "required": ["job_id", "incarnation", "state", "context", "created_at", "timed_out"],
            "additionalProperties": false
          }
        },
        {
          "id": "job.read",
          "args_required": true,
          "args_schema": {
            "type": "object",
            "properties": {
              "job_id": { "type": "string", "minLength": 1 },
              "stream": { "type": "string", "enum": ["stdout", "stderr"], "default": "stdout" },
              "cursor": { "type": "integer", "minimum": 0, "default": 0 },
              "max_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576, "default": 65536 }
            },
            "required": ["job_id"],
            "additionalProperties": false
          },
          "result_schema": {
            "type": "object",
            "properties": {
              "job_id": { "type": "string" },
              "stream": { "type": "string", "enum": ["stdout", "stderr"] },
              "cursor": { "type": "integer", "minimum": 0 },
              "text": { "type": "string" },
              "next_cursor": { "type": "integer", "minimum": 0 },
              "eof": { "type": "boolean" },
              "state": { "type": "string", "enum": ["starting", "running", "completed", "timed_out", "cancelled", "failed", "interrupted"] }
            },
            "required": ["job_id", "stream", "cursor", "text", "next_cursor", "eof", "state"],
            "additionalProperties": false
          }
        },
        {
          "id": "job.wait",
          "args_required": true,
          "args_schema": {
            "type": "object",
            "properties": {
              "job_id": { "type": "string", "minLength": 1 },
              "wait_ms": { "type": "integer", "minimum": 0, "maximum": 86400000, "default": 30000 }
            },
            "required": ["job_id"],
            "additionalProperties": false
          },
          "result_schema": {
            "type": "object",
            "properties": {
              "job": {
            "type": "object",
            "properties": {
              "job_id": { "type": "string", "minLength": 1 },
              "incarnation": { "type": "integer", "minimum": 1 },
              "state": { "type": "string", "enum": ["starting", "running", "completed", "timed_out", "cancelled", "failed", "interrupted"] },
              "context": { "type": "string", "enum": ["system", "user", "wsl"] },
              "pid": { "type": "integer", "minimum": 0 },
              "effective_identity": { "type": "string" },
              "created_at": { "type": "string", "format": "date-time" },
              "started_at": { "type": "string", "format": "date-time" },
              "completed_at": { "type": "string", "format": "date-time" },
              "exit_code": { "type": "integer" },
              "timed_out": { "type": "boolean" },
              "failure_code": { "type": "string" },
              "failure_message": { "type": "string" }
            },
            "required": ["job_id", "incarnation", "state", "context", "created_at", "timed_out"],
            "additionalProperties": false
          },
              "wait_timed_out": { "type": "boolean" }
            },
            "required": ["job", "wait_timed_out"],
            "additionalProperties": false
          }
        },
        {
          "id": "job.result",
          "args_required": true,
          "args_schema": {
            "type": "object",
            "properties": { "job_id": { "type": "string", "minLength": 1 } },
            "required": ["job_id"],
            "additionalProperties": false
          },
          "result_schema": {
            "type": "object",
            "properties": {
              "job_id": { "type": "string", "minLength": 1 },
              "incarnation": { "type": "integer", "minimum": 1 },
              "state": { "type": "string", "enum": ["starting", "running", "completed", "timed_out", "cancelled", "failed", "interrupted"] },
              "context": { "type": "string", "enum": ["system", "user", "wsl"] },
              "pid": { "type": "integer", "minimum": 0 },
              "effective_identity": { "type": "string" },
              "created_at": { "type": "string", "format": "date-time" },
              "started_at": { "type": "string", "format": "date-time" },
              "completed_at": { "type": "string", "format": "date-time" },
              "exit_code": { "type": "integer" },
              "timed_out": { "type": "boolean" },
              "failure_code": { "type": "string" },
              "failure_message": { "type": "string" }
            },
            "required": ["job_id", "incarnation", "state", "context", "created_at", "timed_out"],
            "additionalProperties": false
          }
        }
      ,
        {
          "id": "artifact.info",
          "args_required": true,
          "args_schema": {
            "type": "object",
            "properties": { "artifact_id": { "type": "string", "minLength": 1 } },
            "required": ["artifact_id"],
            "additionalProperties": false
          },
          "result_schema": {
            "type": "object",
            "properties": {
              "artifact_id": { "type": "string", "minLength": 1 },
              "incarnation": { "type": "integer", "minimum": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "mime_type": { "type": "string", "minLength": 1 },
              "size_bytes": { "type": "integer", "minimum": 0 },
              "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
              "name": { "type": "string", "minLength": 1 },
              "storage_tier": { "type": "string", "enum": ["hot", "cold"] },
              "provenance": { "type": "string", "minLength": 1 },
              "created_at": { "type": "string", "format": "date-time" }
            },
            "required": ["artifact_id", "incarnation", "kind", "size_bytes", "sha256", "name", "storage_tier", "provenance", "created_at"],
            "additionalProperties": false
          }
        },
        {
          "id": "artifact.preview",
          "args_required": true,
          "args_schema": {
            "type": "object",
            "properties": {
              "artifact_id": { "type": "string", "minLength": 1 },
              "max_chars": { "type": "integer", "minimum": 1, "maximum": 20000, "default": 4000 }
            },
            "required": ["artifact_id"],
            "additionalProperties": false
          },
          "result_schema": {
            "type": "object",
            "properties": {
              "artifact_id": { "type": "string" },
              "text_available": { "type": "boolean" },
              "text": { "type": "string" },
              "truncated": { "type": "boolean" }
            },
            "required": ["artifact_id", "text_available", "truncated"],
            "additionalProperties": false
          }
        },
        {
          "id": "artifact.read_range",
          "args_required": true,
          "args_schema": {
            "type": "object",
            "properties": {
              "artifact_id": { "type": "string", "minLength": 1 },
              "offset": { "type": "integer", "minimum": 0, "default": 0 },
              "max_bytes": { "type": "integer", "minimum": 1, "maximum": 262144, "default": 65536 }
            },
            "required": ["artifact_id"],
            "additionalProperties": false
          },
          "result_schema": {
            "type": "object",
            "properties": {
              "artifact_id": { "type": "string" },
              "offset": { "type": "integer", "minimum": 0 },
              "bytes_read": { "type": "integer", "minimum": 0 },
              "next_offset": { "type": "integer", "minimum": 0 },
              "eof": { "type": "boolean" },
              "data_base64": { "type": "string" }
            },
            "required": ["artifact_id", "offset", "bytes_read", "next_offset", "eof", "data_base64"],
            "additionalProperties": false
          }
        },
        {
          "id": "artifact.diff",
          "args_required": true,
          "args_schema": {
            "type": "object",
            "properties": {
              "left_artifact_id": { "type": "string", "minLength": 1 },
              "right_artifact_id": { "type": "string", "minLength": 1 }
            },
            "required": ["left_artifact_id", "right_artifact_id"],
            "additionalProperties": false
          },
          "result_schema": {
            "type": "object",
            "properties": {
              "left_artifact_id": { "type": "string" },
              "right_artifact_id": { "type": "string" },
              "equal": { "type": "boolean" },
              "left_size_bytes": { "type": "integer", "minimum": 0 },
              "right_size_bytes": { "type": "integer", "minimum": 0 },
              "left_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
              "right_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
              "first_difference_offset": { "type": "integer", "minimum": 0 }
            },
            "required": ["left_artifact_id", "right_artifact_id", "equal", "left_size_bytes", "right_size_bytes", "left_sha256", "right_sha256"],
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "name": "eye_run",
      "effect_class": "run",
      "description": "Run SYSTEM, active-user, WSL, process, PowerShell, terminal, and ConPTY execution operations.",
      "machine_effects": "local-execution",
      "operations": [
        {
          "id": "run",
          "args_required": true,
          "args_schema": {
            "type": "object",
            "properties": {
              "context": { "type": "string", "enum": ["system", "user", "wsl"], "default": "system" },
              "file_name": { "type": "string", "minLength": 1 },
              "arguments": { "type": "array", "items": { "type": "string" }, "default": [] },
              "working_directory": { "type": "string" },
              "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 86400000, "default": 30000 }
            },
            "required": ["file_name"],
            "additionalProperties": false
          },
          "result_schema": {
            "oneOf": [
              {
            "type": "object",
            "properties": {
              "pid": { "type": "integer" },
              "exit_code": { "type": "integer" },
              "timed_out": { "type": "boolean" },
              "stdout": { "type": "string" },
              "stderr": { "type": "string" },
              "context": { "type": "string" },
              "effective_identity": { "type": "string" },
              "duration_ms": { "type": "integer", "minimum": 0 }
            },
            "required": ["pid", "exit_code", "timed_out", "stdout", "stderr", "context", "effective_identity", "duration_ms"],
            "additionalProperties": false
          },
              {
              "type": "object",
              "properties": {
                "job_id": { "type": "string", "minLength": 1 },
                "incarnation": { "type": "integer", "minimum": 1 },
                "state": { "type": "string", "enum": ["starting", "running", "completed", "timed_out", "cancelled", "failed", "interrupted"] }
              },
              "required": ["job_id", "incarnation", "state"],
              "additionalProperties": false
            }
            ]
          }
        }
      ,
        {
          "id": "job.start",
          "args_required": true,
          "args_schema": {
            "type": "object",
            "properties": {
              "context": { "type": "string", "enum": ["system", "user", "wsl"], "default": "system" },
              "file_name": { "type": "string", "minLength": 1 },
              "arguments": { "type": "array", "items": { "type": "string" }, "default": [] },
              "working_directory": { "type": "string" },
              "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 86400000, "default": 30000 }
            },
            "required": ["file_name"],
            "additionalProperties": false
          },
          "result_schema": {
            "type": "object",
            "properties": {
              "job_id": { "type": "string", "minLength": 1 },
              "incarnation": { "type": "integer", "minimum": 1 },
              "state": { "type": "string", "enum": ["starting", "running", "completed", "timed_out", "cancelled", "failed", "interrupted"] }
            },
            "required": ["job_id", "incarnation", "state"],
            "additionalProperties": false
          }
        },
        {
          "id": "job.cancel",
          "args_required": true,
          "args_schema": {
            "type": "object",
            "properties": { "job_id": { "type": "string", "minLength": 1 } },
            "required": ["job_id"],
            "additionalProperties": false
          },
          "result_schema": {
            "type": "object",
            "properties": {
              "job_id": { "type": "string" },
              "state": { "type": "string", "enum": ["starting", "running", "completed", "timed_out", "cancelled", "failed", "interrupted"] }
            },
            "required": ["job_id", "state"],
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "name": "eye_change",
      "effect_class": "change",
      "description": "Apply precisely typed local file, machine, service, package, storage, snapshot, and configuration changes.",
      "machine_effects": "local-write",
      "operations": [
        {
          "id": "artifact.export",
          "args_required": true,
          "args_schema": {
            "type": "object",
            "properties": {
              "artifact_id": { "type": "string", "minLength": 1 },
              "destination": { "type": "string", "minLength": 1 },
              "overwrite": { "type": "boolean", "default": false }
            },
            "required": ["artifact_id", "destination"],
            "additionalProperties": false
          },
          "result_schema": {
            "type": "object",
            "properties": {
              "artifact_id": { "type": "string" },
              "destination": { "type": "string" },
              "size_bytes": { "type": "integer", "minimum": 0 },
              "sha256": { "type": "string", "minLength": 64, "maxLength": 64 }
            },
            "required": ["artifact_id", "destination", "size_bytes", "sha256"],
            "additionalProperties": false
          }
        },
        {
          "id": "artifact.delete",
          "args_required": true,
          "args_schema": {
            "type": "object",
            "properties": { "artifact_id": { "type": "string", "minLength": 1 } },
            "required": ["artifact_id"],
            "additionalProperties": false
          },
          "result_schema": {
            "type": "object",
            "properties": {
              "artifact_id": { "type": "string" },
              "deleted": { "type": "boolean" }
            },
            "required": ["artifact_id", "deleted"],
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "name": "eye_interact",
      "effect_class": "interact",
      "description": "Interact with Windows applications, UI Automation, input, clipboard, and Chrome/CDP user interfaces.",
      "machine_effects": "interactive",
      "operations": []
    },
    {
      "name": "eye_external",
      "effect_class": "external",
      "description": "Perform HTTP, upload, send, post, provider administration, remote transfer, and other effects leaving the laptop.",
      "machine_effects": "open-world",
      "operations": []
    },
    {
      "name": "eye_live",
      "effect_class": "ui",
      "description": "Open the Eye Live mission, job, trigger, artifact, and relay component. This tool performs no machine operation itself.",
      "machine_effects": "none",
      "ui_only": true,
      "operations": []
    }
  ],
  "host_engine_protocol": {
    "version": "1.0.0",
    "transport": "stream-json-rpc-over-named-pipes",
    "worker_protocol_version": "1.0.0",
    "engine_operation_ids": [],
    "contract_hash": {
      "algorithm": "sha256",
      "encoding": "lowercase-hex",
      "scope": "canonical-json-utf8"
    },
    "engine_handshake": {
      "required": [
        "engine_protocol_version",
        "engine_version",
        "public_contract_hash",
        "supported_operation_ids",
        "worker_protocol_version"
      ]
    }
  },
  "architectural_primitives": {
    "observe": "Structured machine, UI, browser, process, file, job, artifact, and event state.",
    "act": "Raw execution or precise typed changes/interactions/external effects.",
    "wait": "Event-driven condition waiting exposed as typed operations, primarily through eye_inspect rather than a separate top-level tool.",
    "transfer": "Artifact and file movement exposed as typed operations in the appropriate effect facade rather than a separate top-level tool."
  },
  "host_guarantees_when_engine_unavailable": [
    "system.status",
    "capabilities",
    "engine.status",
    "engine.restart",
    "engine.activate",
    "engine.rollback",
    "raw SYSTEM execution",
    "raw active-user execution",
    "raw WSL execution",
    "job status/read/wait/write/resize/cancel/result",
    "terminal access",
    "artifact info/read",
    "mission state",
    "trigger state",
    "minimal Eye Live monitoring"
  ],
  "schema_profile": {
    "operation_variants": "closed-and-generated",
    "preferred_constructs": [
      "objects",
      "primitives",
      "arrays",
      "enums",
      "bounds",
      "required",
      "additionalProperties:false"
    ],
    "avoid": [
      "deep-recursion",
      "deep-composition",
      "conditionals",
      "nullable-unions",
      "schema-cleverness"
    ],
    "optional_values": "omit-rather-than-null",
    "output_schema_required": true,
    "raw_exception_details_model_visible": false,
    "large_results": "artifact-plus-useful-excerpt"
  },
  "error_schema": {
    "type": "object",
    "properties": {
      "code": { "type": "string" },
      "message": { "type": "string" },
      "retryable": { "type": "boolean" },
      "expected": { "type": "object" }
    },
    "required": ["code", "message", "retryable"],
    "additionalProperties": false
  },
  "stable_identifiers": {
    "job_id": true,
    "artifact_id": true,
    "stream_id": true,
    "stable_object_id": true,
    "incarnation_generation": true,
    "observation_cursor": true
  },
  "ui": {
    "eye_live": {
      "resource_link": "_meta.ui.resourceUri",
      "portable_bridge": "MCP Apps ui/* JSON-RPC",
      "follow_up_message": "ui/message",
      "helpers": "app-only via _meta.ui.visibility:[app]",
      "must_not_be_required_for_core_operation": true
    },
    "file_inputs": {
      "chatgpt_bridge": "top-level file parameters via _meta[openai/fileParams] where applicable"
    }
  },
  "generation": {
    "single_source": true,
    "targets": [
      "mcp_tool_descriptors",
      "csharp_request_result_types",
      "host_contract_validation",
      "operation_to_facade_registration",
      "capabilities",
      "server_instructions",
      "documentation",
      "normalized_tools_list_snapshot"
    ]
  },
  "activation_gate": [
    "generated exact descriptors exist",
    "host fallback operations exist",
    "host-engine protocol and contract-hash handshake exist",
    "eye_live UI resource exists",
    "normalized tools/list snapshot passes"
  ],
  "revision_policy": {
    "v1_is_historical_and_immutable": true,
    "six_tool_names_are_frozen_for_v2": true,
    "ordinary_implementation_changes_must_not_modify_public_contract": true,
    "public_operation_or_schema_changes_require_explicit_owner_authorized_contract_revision": true,
    "additive_operation_revisions_may_remain_within_major_v2": true,
    "breaking_surface_changes_require_new_major_version": true
  }
}
